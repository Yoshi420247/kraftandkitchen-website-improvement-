{% comment %}
  Kraft & Kitchen - Mega Menu Snippet
  File: snippets/mega-menu.liquid

  Navigation mega menu with:
  - Shop by Project column
  - Products column
  - Resources column
  - Featured product
{% endcomment %}

<style>
  .mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s ease;
    z-index: 1000;
  }

  .nav-item:hover .mega-menu,
  .nav-item:focus-within .mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mega-menu__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 24px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 240px;
    gap: 40px;
  }

  .mega-menu__column {
    display: flex;
    flex-direction: column;
  }

  .mega-menu__column-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: #1A7F7F;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid #E5E5E5;
  }

  .mega-menu__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mega-menu__link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    color: #2D2D2D;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .mega-menu__link:hover {
    color: #1A7F7F;
  }

  .mega-menu__link-icon {
    font-size: 1.1rem;
    width: 24px;
    text-align: center;
  }

  .mega-menu__link-text {
    flex: 1;
  }

  .mega-menu__link-badge {
    background: #F59E0B;
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 3px;
    text-transform: uppercase;
  }

  .mega-menu__featured {
    background: #FAF8F5;
    border-radius: 8px;
    padding: 16px;
    text-align: center;
  }

  .mega-menu__featured-image {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 12px;
  }

  .mega-menu__featured-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #2D2D2D;
    margin: 0 0 8px;
  }

  .mega-menu__featured-price {
    font-size: 0.95rem;
    color: #1A7F7F;
    font-weight: 600;
    margin: 0 0 12px;
  }

  .mega-menu__featured-btn {
    display: inline-block;
    width: 100%;
    padding: 10px 16px;
    background: #1A7F7F;
    color: white;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 6px;
    transition: background 0.2s ease;
  }

  .mega-menu__featured-btn:hover {
    background: #156666;
  }

  .mega-menu__divider {
    width: 1px;
    background: #E5E5E5;
    margin: 0 20px;
  }

  /* Mobile: Hide mega menu, use accordion */
  @media (max-width: 991px) {
    .mega-menu {
      display: none;
    }
  }
</style>

<div class="mega-menu">
  <div class="mega-menu__container">

    <!-- Column 1: Shop by Project -->
    <div class="mega-menu__column">
      <h3 class="mega-menu__column-title">Shop by Project</h3>
      <ul class="mega-menu__links">
        <li>
          <a href="/collections/stickers" class="mega-menu__link">
            <span class="mega-menu__link-icon">📒</span>
            <span class="mega-menu__link-text">Sticker Storage</span>
          </a>
        </li>
        <li>
          <a href="/collections/heat-press" class="mega-menu__link">
            <span class="mega-menu__link-icon">🔥</span>
            <span class="mega-menu__link-text">Heat Press Protection</span>
          </a>
        </li>
        <li>
          <a href="/collections/diamond-painting" class="mega-menu__link">
            <span class="mega-menu__link-icon">💎</span>
            <span class="mega-menu__link-text">Diamond Painting</span>
          </a>
        </li>
        <li>
          <a href="/collections/transfers" class="mega-menu__link">
            <span class="mega-menu__link-icon">🔄</span>
            <span class="mega-menu__link-text">Transfers & Decals</span>
          </a>
        </li>
        <li>
          <a href="/collections/resin" class="mega-menu__link">
            <span class="mega-menu__link-icon">🧪</span>
            <span class="mega-menu__link-text">Resin & Glue</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Column 2: Products -->
    <div class="mega-menu__column">
      <h3 class="mega-menu__column-title">Products</h3>
      <ul class="mega-menu__links">
        <li>
          <a href="/collections/ptfe-cover-sheets" class="mega-menu__link">
            <span class="mega-menu__link-text">PTFE Cover Sheets</span>
            <span class="mega-menu__link-badge">Best Seller</span>
          </a>
        </li>
        <li>
          <a href="/collections/release-paper" class="mega-menu__link">
            <span class="mega-menu__link-text">Silicone Release Paper</span>
          </a>
        </li>
        <li>
          <a href="/collections/diamond-painting-squares" class="mega-menu__link">
            <span class="mega-menu__link-text">Diamond Painting Squares</span>
          </a>
        </li>
        <li>
          <a href="/collections/silicone-mats" class="mega-menu__link">
            <span class="mega-menu__link-text">Silicone Work Mats</span>
          </a>
        </li>
        <li>
          <a href="/collections/bulk" class="mega-menu__link">
            <span class="mega-menu__link-text">Bulk & Rolls</span>
          </a>
        </li>
        <li>
          <a href="/collections/all" class="mega-menu__link">
            <span class="mega-menu__link-text">View All Products</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Column 3: Resources -->
    <div class="mega-menu__column">
      <h3 class="mega-menu__column-title">Resources</h3>
      <ul class="mega-menu__links">
        <li>
          <a href="/pages/size-finder" class="mega-menu__link">
            <span class="mega-menu__link-icon">📐</span>
            <span class="mega-menu__link-text">Size Finder</span>
          </a>
        </li>
        <li>
          <a href="/pages/ptfe-vs-parchment" class="mega-menu__link">
            <span class="mega-menu__link-text">PTFE vs Parchment Paper</span>
          </a>
        </li>
        <li>
          <a href="/pages/heat-press-settings" class="mega-menu__link">
            <span class="mega-menu__link-text">Heat Press Settings Guide</span>
          </a>
        </li>
        <li>
          <a href="/pages/sticker-book-guide" class="mega-menu__link">
            <span class="mega-menu__link-text">Sticker Book Guide</span>
          </a>
        </li>
        <li>
          <a href="/blogs/tips" class="mega-menu__link">
            <span class="mega-menu__link-text">Tips & Tutorials</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Column 4: Featured Product -->
    <div class="mega-menu__column">
      <div class="mega-menu__featured">
        <img
          src="{{ 'ptfe-cover-sheet-featured.jpg' | asset_url }}"
          alt="PTFE Cover Sheet"
          class="mega-menu__featured-image"
          loading="lazy"
        >
        <h4 class="mega-menu__featured-title">PTFE Cover Sheet 16x20</h4>
        <p class="mega-menu__featured-price">From $8.99</p>
        <a href="/products/ptfe-cover-sheet-16x20" class="mega-menu__featured-btn">
          Shop Now
        </a>
      </div>
    </div>

  </div>
</div>
