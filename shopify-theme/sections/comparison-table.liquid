{% comment %}
  Kraft & Kitchen - Product Comparison Table Section
  Compare multiple products side by side
{% endcomment %}

{% schema %}
{
  "name": "Comparison Table",
  "tag": "section",
  "class": "comparison-table-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare Our Products"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Not sure which product is right for you? Here's a quick comparison."
    }
  ],
  "blocks": [
    {
      "type": "product_column",
      "name": "Product",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Mark as recommended",
          "default": false
        },
        {
          "type": "text",
          "id": "best_for",
          "label": "Best for",
          "default": "Heat press users"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Reusable"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "500°F rated"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3",
          "default": "Easy clean"
        },
        {
          "type": "text",
          "id": "feature_4",
          "label": "Feature 4"
        },
        {
          "type": "text",
          "id": "feature_5",
          "label": "Feature 5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        {
          "type": "product_column",
          "settings": {
            "best_for": "Heat press",
            "feature_1": "Reusable hundreds of times",
            "feature_2": "500°F temperature rating",
            "feature_3": "PTFE-coated fiberglass",
            "feature_4": "Wipes clean easily"
          }
        },
        {
          "type": "product_column",
          "settings": {
            "featured": true,
            "best_for": "Stickers & transfers",
            "feature_1": "Double-sided silicone",
            "feature_2": "Clean release",
            "feature_3": "Fits standard binders",
            "feature_4": "Moisture resistant"
          }
        },
        {
          "type": "product_column",
          "settings": {
            "best_for": "Diamond painting",
            "feature_1": "Pre-cut 4x4 squares",
            "feature_2": "Double-sided coating",
            "feature_3": "Protects adhesive",
            "feature_4": "Reusable until worn"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .comparison-table {
    padding: var(--space-3xl) var(--space-lg);
    background: var(--color-background);
  }

  .comparison-table__container {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .comparison-table__header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .comparison-table__heading {
    font-family: var(--font-heading);
    font-size: 2rem;
    margin: 0 0 var(--space-sm);
  }

  .comparison-table__subheading {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .comparison-table__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    gap: var(--space-md);
  }

  .comparison-card {
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    text-align: center;
    position: relative;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .comparison-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .comparison-card.is-featured {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .comparison-card__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
  }

  .comparison-card__image {
    width: 120px;
    height: 120px;
    margin: 0 auto var(--space-lg);
    background: var(--color-background-warm);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .comparison-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .comparison-card__title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 var(--space-sm);
    min-height: 2.4em;
  }

  .comparison-card__price {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .comparison-card__best-for {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .comparison-card__features {
    list-style: none;
    margin: 0 0 var(--space-xl);
    padding: 0;
    text-align: left;
  }

  .comparison-card__feature {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-sm) 0;
    font-size: 0.9rem;
    border-bottom: 1px solid var(--color-border);
  }

  .comparison-card__feature:last-child {
    border-bottom: none;
  }

  .comparison-card__feature-icon {
    color: var(--color-success);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .comparison-card__cta {
    display: block;
    padding: var(--space-md);
    background: var(--color-primary);
    color: white;
    text-decoration: none;
    border-radius: var(--radius-md);
    font-weight: 600;
    transition: background var(--transition-fast);
  }

  .comparison-card__cta:hover {
    background: var(--color-primary-dark);
    color: white;
  }

  @media (max-width: 991px) {
    .comparison-table__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .comparison-table__grid {
      grid-template-columns: 1fr;
      max-width: 400px;
      margin: 0 auto;
    }

    .comparison-card {
      padding: var(--space-lg);
    }
  }
</style>

{% if section.blocks.size > 0 %}
<div class="comparison-table">
  <div class="comparison-table__container">

    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="comparison-table__header">
        {% if section.settings.heading != blank %}
          <h2 class="comparison-table__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="comparison-table__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="comparison-table__grid">
      {% for block in section.blocks %}
        {% if block.type == 'product_column' %}
          {% assign product = block.settings.product %}
          <div class="comparison-card{% if block.settings.featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>

            {% if block.settings.featured %}
              <span class="comparison-card__badge">Recommended</span>
            {% endif %}

            <div class="comparison-card__image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: '240x240', crop: 'center' }}" alt="{{ product.title }}">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>

            <h3 class="comparison-card__title">
              {% if product %}{{ product.title }}{% else %}Product Name{% endif %}
            </h3>

            <p class="comparison-card__price">
              {% if product %}{{ product.price | money }}{% else %}$0.00{% endif %}
            </p>

            {% if block.settings.best_for != blank %}
              <p class="comparison-card__best-for">Best for: {{ block.settings.best_for }}</p>
            {% endif %}

            <ul class="comparison-card__features">
              {% if block.settings.feature_1 != blank %}
                <li class="comparison-card__feature">
                  <svg class="comparison-card__feature-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                  </svg>
                  {{ block.settings.feature_1 }}
                </li>
              {% endif %}
              {% if block.settings.feature_2 != blank %}
                <li class="comparison-card__feature">
                  <svg class="comparison-card__feature-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                  </svg>
                  {{ block.settings.feature_2 }}
                </li>
              {% endif %}
              {% if block.settings.feature_3 != blank %}
                <li class="comparison-card__feature">
                  <svg class="comparison-card__feature-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                  </svg>
                  {{ block.settings.feature_3 }}
                </li>
              {% endif %}
              {% if block.settings.feature_4 != blank %}
                <li class="comparison-card__feature">
                  <svg class="comparison-card__feature-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                  </svg>
                  {{ block.settings.feature_4 }}
                </li>
              {% endif %}
              {% if block.settings.feature_5 != blank %}
                <li class="comparison-card__feature">
                  <svg class="comparison-card__feature-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                  </svg>
                  {{ block.settings.feature_5 }}
                </li>
              {% endif %}
            </ul>

            {% if product %}
              <a href="{{ product.url }}" class="comparison-card__cta">View Product</a>
            {% else %}
              <a href="/collections/all" class="comparison-card__cta">Shop Now</a>
            {% endif %}

          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</div>
{% endif %}
