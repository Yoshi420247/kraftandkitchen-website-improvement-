{% comment %}
  Kraft & Kitchen - Footer Section
{% endcomment %}

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "site-footer-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "Premium craft supplies for makers who demand quality. Based in Washington state, shipping nationwide."
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Get 10% Off Your First Order"
    },
    {
      "type": "text",
      "id": "newsletter_subtext",
      "label": "Newsletter subtext",
      "default": "Plus craft tips, new products, and exclusive deals."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact Info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact Us"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "hello@kraftandkitchen.com"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Hours",
          "default": "Mon-Fri 9am-5pm PST"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "link_list",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "link_list",
          "settings": {
            "heading": "Help"
          }
        },
        {
          "type": "contact"
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .site-footer {
    background: var(--color-text);
    color: white;
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: var(--space-2xl);
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  /* Brand Column */
  .footer-brand {
    padding-right: var(--space-xl);
  }

  .footer-logo {
    margin-bottom: var(--space-lg);
  }

  .footer-logo img {
    max-width: 150px;
    height: auto;
  }

  .footer-logo-text {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
  }

  .footer-about {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }

  .footer-social {
    display: flex;
    gap: var(--space-sm);
  }

  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    color: white;
    transition: background var(--transition-fast);
  }

  .footer-social a:hover {
    background: var(--color-primary);
  }

  .footer-social svg {
    width: 20px;
    height: 20px;
  }

  /* Link Columns */
  .footer-column h4 {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-lg);
    color: white;
  }

  .footer-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-column li {
    margin-bottom: var(--space-sm);
  }

  .footer-column a {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--transition-fast);
  }

  .footer-column a:hover {
    color: white;
  }

  /* Contact Info */
  .footer-contact p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 var(--space-sm);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .footer-contact a {
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-contact a:hover {
    color: white;
  }

  .footer-contact svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Newsletter */
  .footer-newsletter {
    background: rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin: var(--space-2xl) auto 0;
    max-width: var(--container-max);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .footer-newsletter__content h3 {
    font-size: 1.25rem;
    margin: 0 0 var(--space-xs);
    color: white;
  }

  .footer-newsletter__content p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .footer-newsletter__form {
    display: flex;
    gap: var(--space-sm);
    flex: 1;
    max-width: 400px;
  }

  .footer-newsletter__input {
    flex: 1;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 0.95rem;
  }

  .footer-newsletter__input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .footer-newsletter__input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .footer-newsletter__btn {
    padding: var(--space-md) var(--space-xl);
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-weight: 600;
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .footer-newsletter__btn:hover {
    background: var(--color-primary-dark);
  }

  /* Bottom Bar */
  .footer-bottom {
    max-width: var(--container-max);
    margin: var(--space-2xl) auto 0;
    padding: var(--space-lg) var(--space-lg) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .footer-copyright {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer-payments {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .footer-payments svg {
    width: 38px;
    height: 24px;
    fill: rgba(255, 255, 255, 0.5);
  }

  /* Mobile Styles */
  @media (max-width: 991px) {
    .footer-main {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-brand {
      grid-column: span 2;
      padding-right: 0;
    }
  }

  @media (max-width: 600px) {
    .footer-main {
      grid-template-columns: 1fr;
    }

    .footer-brand {
      grid-column: span 1;
    }

    .footer-newsletter {
      flex-direction: column;
      text-align: center;
    }

    .footer-newsletter__form {
      flex-direction: column;
      width: 100%;
      max-width: none;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

<div class="site-footer">

  <div class="footer-main">

    <!-- Brand Column -->
    <div class="footer-brand">
      <div class="footer-logo">
        {% if section.settings.logo %}
          <img src="{{ section.settings.logo | img_url: 'x60' }}" alt="{{ shop.name }}">
        {% else %}
          <span class="footer-logo-text">{{ shop.name }}</span>
        {% endif %}
      </div>

      {% if section.settings.about_text != blank %}
        <p class="footer-about">{{ section.settings.about_text }}</p>
      {% endif %}

      <div class="footer-social">
        {% if settings.social_instagram_link != blank %}
          <a href="{{ settings.social_instagram_link }}" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        {% endif %}
        {% if settings.social_facebook_link != blank %}
          <a href="{{ settings.social_facebook_link }}" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        {% endif %}
        {% if settings.social_pinterest_link != blank %}
          <a href="{{ settings.social_pinterest_link }}" aria-label="Pinterest">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2a10 10 0 0 0-4 19.17c0-.73.05-1.78.15-2.54l1.05-4.42s-.26-.53-.26-1.31c0-1.23.71-2.15 1.6-2.15.76 0 1.12.57 1.12 1.25 0 .76-.48 1.9-.74 2.95-.21.89.45 1.61 1.33 1.61 1.6 0 2.68-2.06 2.68-4.48 0-1.85-1.24-3.23-3.5-3.23a4 4 0 0 0-4.16 4.01c0 .73.22 1.24.56 1.64.16.18.18.25.12.46l-.17.66c-.05.21-.22.29-.4.21-1.12-.46-1.64-1.68-1.64-3.06 0-2.27 1.92-5 5.73-5 3.06 0 5.07 2.21 5.07 4.6 0 3.15-1.75 5.5-4.33 5.5-.87 0-1.68-.47-1.96-1l-.55 2.17c-.17.6-.5 1.2-.8 1.68A10 10 0 1 0 12 2z"></path>
            </svg>
          </a>
        {% endif %}
        {% if settings.social_tiktok_link != blank %}
          <a href="{{ settings.social_tiktok_link }}" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>

    <!-- Link Columns -->
    {% for block in section.blocks %}
      {% if block.type == 'link_list' %}
        <div class="footer-column" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h4>{{ block.settings.heading }}</h4>
          {% endif %}
          {% if block.settings.menu != blank %}
            <ul>
              {% for link in linklists[block.settings.menu].links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% elsif block.type == 'contact' %}
        <div class="footer-column footer-contact" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h4>{{ block.settings.heading }}</h4>
          {% endif %}
          {% if block.settings.email != blank %}
            <p>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
            </p>
          {% endif %}
          {% if block.settings.phone != blank %}
            <p>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '-' }}">{{ block.settings.phone }}</a>
            </p>
          {% endif %}
          {% if block.settings.hours != blank %}
            <p>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              {{ block.settings.hours }}
            </p>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}

  </div>

  <!-- Newsletter -->
  {% if section.settings.newsletter_heading != blank %}
    <div class="footer-newsletter container">
      <div class="footer-newsletter__content">
        <h3>{{ section.settings.newsletter_heading }}</h3>
        {% if section.settings.newsletter_subtext != blank %}
          <p>{{ section.settings.newsletter_subtext }}</p>
        {% endif %}
      </div>
      <form class="footer-newsletter__form" action="{{ routes.root_url }}" method="post">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="customer[tags]" value="newsletter">
        <input type="email" name="customer[email]" class="footer-newsletter__input" placeholder="Enter your email" required>
        <button type="submit" class="footer-newsletter__btn">Subscribe</button>
      </form>
    </div>
  {% endif %}

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <p class="footer-copyright">© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    <div class="footer-payments">
      {{ shop.enabled_payment_types | payment_type_svg_tag }}
    </div>
  </div>

</div>
