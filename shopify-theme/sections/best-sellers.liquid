{% comment %}
  Kraft & Kitchen - Best Sellers Section
  File: sections/best-sellers.liquid

  Homepage section showing top-selling products with
  product cards in a horizontal scroll or grid.
{% endcomment %}

{% schema %}
{
  "name": "Best Sellers",
  "tag": "section",
  "class": "best-sellers-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Top picks from our craft community"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "View all best sellers"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers"
    }
  ]
}
{% endschema %}

<style>
  .best-sellers {
    padding: 64px 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .best-sellers__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
  }

  .best-sellers__heading {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 2rem;
    color: #2D2D2D;
    margin: 0;
  }

  .best-sellers__subheading {
    font-size: 1rem;
    color: #6B6B6B;
    margin: 4px 0 0;
  }

  .best-sellers__view-all {
    font-size: 0.95rem;
    color: #1A7F7F;
    text-decoration: none;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .best-sellers__view-all:hover {
    text-decoration: underline;
  }

  .best-sellers__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  /* Product Card */
  .product-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .product-card:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .product-card__image-wrapper {
    position: relative;
    aspect-ratio: 1;
    background: #FAF8F5;
    overflow: hidden;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #1A7F7F;
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .product-card__badge--sale {
    background: #DC2626;
  }

  .product-card__content {
    padding: 16px;
  }

  .product-card__vendor {
    font-size: 0.8rem;
    color: #6B6B6B;
    margin: 0 0 4px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .product-card__title {
    font-size: 1rem;
    font-weight: 600;
    color: #2D2D2D;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .product-card__title a:hover {
    color: #1A7F7F;
  }

  .product-card__price {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    font-weight: 600;
    color: #2D2D2D;
  }

  .product-card__price-compare {
    font-size: 0.9rem;
    color: #9A9A9A;
    text-decoration: line-through;
    font-weight: 400;
  }

  .product-card__reviews {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-size: 0.85rem;
  }

  .product-card__stars {
    color: #F59E0B;
  }

  .product-card__review-count {
    color: #6B6B6B;
  }

  /* Quick add button */
  .product-card__quick-add {
    width: 100%;
    padding: 12px;
    margin-top: 12px;
    background: transparent;
    border: 2px solid #1A7F7F;
    border-radius: 8px;
    color: #1A7F7F;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .product-card__quick-add:hover {
    background: #1A7F7F;
    color: white;
  }

  @media (max-width: 991px) {
    .best-sellers__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 768px) {
    .best-sellers {
      padding: 48px 16px;
    }

    .best-sellers__heading {
      font-size: 1.5rem;
    }

    .best-sellers__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .product-card__content {
      padding: 12px;
    }

    .product-card__title {
      font-size: 0.9rem;
    }
  }
</style>

{% assign collection = section.settings.collection %}

<div class="best-sellers">
  <div class="best-sellers__header">
    <div>
      {% if section.settings.heading != blank %}
        <h2 class="best-sellers__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="best-sellers__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
    {% if section.settings.view_all_link != blank %}
      <a href="{{ section.settings.view_all_link }}" class="best-sellers__view-all">
        {{ section.settings.view_all_text }}
        <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>

  {% if collection != blank and collection.products.size > 0 %}
    <div class="best-sellers__grid">
      {% for product in collection.products limit: section.settings.products_to_show %}
        <div class="product-card">
          <div class="product-card__image-wrapper">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="product-card__image"
                loading="lazy"
              >
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
            {% endif %}

            {% if product.compare_at_price > product.price %}
              <span class="product-card__badge product-card__badge--sale">Sale</span>
            {% elsif product.tags contains 'bestseller' %}
              <span class="product-card__badge">Best Seller</span>
            {% endif %}
          </div>

          <div class="product-card__content">
            {% if product.metafields.kk.best_for.value.first %}
              <p class="product-card__vendor">{{ product.metafields.kk.best_for.value.first | capitalize }}</p>
            {% endif %}

            <h3 class="product-card__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            <div class="product-card__price">
              {{ product.price | money }}
              {% if product.compare_at_price > product.price %}
                <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>

            <div class="product-card__reviews">
              <span class="product-card__stars">★★★★★</span>
              <span class="product-card__review-count">(0)</span>
            </div>

            <button
              type="button"
              class="product-card__quick-add"
              data-product-id="{{ product.id }}"
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            >
              Quick Add
            </button>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <!-- Fallback: Display placeholder cards -->
    <div class="best-sellers__grid">
      {% for i in (1..4) %}
        <div class="product-card">
          <div class="product-card__image-wrapper">
            {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
          </div>
          <div class="product-card__content">
            <p class="product-card__vendor">Heat Press</p>
            <h3 class="product-card__title">
              <a href="#">PTFE Cover Sheet 16x20</a>
            </h3>
            <div class="product-card__price">$8.99</div>
            <div class="product-card__reviews">
              <span class="product-card__stars">★★★★★</span>
              <span class="product-card__review-count">(0)</span>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<script>
  document.querySelectorAll('.product-card__quick-add').forEach(button => {
    button.addEventListener('click', async function() {
      const variantId = this.dataset.variantId;
      if (!variantId) return;

      this.disabled = true;
      this.textContent = 'Adding...';

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        });

        if (response.ok) {
          this.textContent = 'Added!';
          setTimeout(() => {
            this.textContent = 'Quick Add';
            this.disabled = false;
          }, 2000);

          // Trigger cart update event
          document.dispatchEvent(new CustomEvent('cart:updated'));
        } else {
          throw new Error('Failed to add');
        }
      } catch (error) {
        this.textContent = 'Error';
        setTimeout(() => {
          this.textContent = 'Quick Add';
          this.disabled = false;
        }, 2000);
      }
    });
  });
</script>
