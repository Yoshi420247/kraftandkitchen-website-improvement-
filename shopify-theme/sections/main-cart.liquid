{% comment %}
  Kraft & Kitchen - Main Cart Section
  Full cart page with items, totals, and checkout
{% endcomment %}

{% schema %}
{
  "name": "Main Cart",
  "tag": "section",
  "class": "main-cart-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_notes",
      "label": "Show order notes",
      "default": true
    },
    {
      "type": "text",
      "id": "notes_placeholder",
      "label": "Notes placeholder",
      "default": "Add a note to your order..."
    }
  ]
}
{% endschema %}

<style>
  .main-cart {
    padding: var(--space-2xl) var(--space-lg) var(--space-3xl);
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .main-cart__header {
    margin-bottom: var(--space-2xl);
  }

  .main-cart__title {
    font-family: var(--font-heading);
    font-size: 2rem;
    margin: 0;
  }

  .main-cart__empty {
    text-align: center;
    padding: var(--space-3xl) var(--space-lg);
  }

  .main-cart__empty-icon {
    font-size: 4rem;
    margin-bottom: var(--space-lg);
  }

  .main-cart__empty-title {
    font-size: 1.5rem;
    margin: 0 0 var(--space-sm);
  }

  .main-cart__empty-text {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-xl);
  }

  .main-cart__empty-btn {
    display: inline-block;
    padding: var(--space-md) var(--space-2xl);
    background: var(--color-primary);
    color: white;
    text-decoration: none;
    border-radius: var(--radius-md);
    font-weight: 600;
  }

  .main-cart__grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* Cart Items */
  .main-cart__items {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .main-cart__item {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
    align-items: center;
  }

  .main-cart__item:last-child {
    border-bottom: none;
  }

  .main-cart__item-image {
    width: 100px;
    height: 100px;
    background: var(--color-background-warm);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .main-cart__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .main-cart__item-details {
    min-width: 0;
  }

  .main-cart__item-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 var(--space-xs);
  }

  .main-cart__item-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .main-cart__item-title a:hover {
    color: var(--color-primary);
  }

  .main-cart__item-variant {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-sm);
  }

  .main-cart__item-price {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .main-cart__item-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-md);
  }

  .main-cart__item-total {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .main-cart__quantity {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .main-cart__quantity-btn {
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    color: var(--color-text);
    transition: background var(--transition-fast);
  }

  .main-cart__quantity-btn:hover {
    background: var(--color-background-warm);
  }

  .main-cart__quantity-value {
    width: 48px;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 500;
    border: none;
    background: transparent;
  }

  .main-cart__remove {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
  }

  .main-cart__remove:hover {
    color: var(--color-error);
  }

  /* Cart Summary */
  .main-cart__summary {
    background: var(--color-background-warm);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    position: sticky;
    top: 100px;
  }

  .main-cart__summary-title {
    font-size: 1.25rem;
    margin: 0 0 var(--space-lg);
  }

  /* Free Shipping Progress */
  .main-cart__shipping {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .main-cart__shipping-text {
    font-size: 0.9rem;
    text-align: center;
    margin-bottom: var(--space-sm);
  }

  .main-cart__shipping-text strong {
    color: var(--color-primary);
  }

  .main-cart__shipping-bar {
    height: 8px;
    background: var(--color-border);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .main-cart__shipping-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    border-radius: var(--radius-full);
    transition: width 0.3s ease;
  }

  .main-cart__summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-md);
    font-size: 0.95rem;
  }

  .main-cart__summary-row--total {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .main-cart__notes {
    margin: var(--space-lg) 0;
  }

  .main-cart__notes-label {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: var(--space-sm);
  }

  .main-cart__notes-input {
    width: 100%;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    resize: vertical;
    min-height: 80px;
  }

  .main-cart__checkout {
    display: block;
    width: 100%;
    padding: var(--space-md);
    background: var(--color-primary);
    color: white;
    text-align: center;
    text-decoration: none;
    border: none;
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .main-cart__checkout:hover {
    background: var(--color-primary-dark);
    color: white;
  }

  .main-cart__continue {
    display: block;
    text-align: center;
    margin-top: var(--space-md);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .main-cart__continue:hover {
    color: var(--color-primary);
  }

  .main-cart__trust {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .main-cart__trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 991px) {
    .main-cart__grid {
      grid-template-columns: 1fr;
    }

    .main-cart__summary {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .main-cart__item {
      grid-template-columns: 80px 1fr;
      grid-template-rows: auto auto;
    }

    .main-cart__item-image {
      width: 80px;
      height: 80px;
    }

    .main-cart__item-actions {
      grid-column: span 2;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>

<div class="main-cart">

  <div class="main-cart__header">
    <h1 class="main-cart__title">Your Cart ({{ cart.item_count }})</h1>
  </div>

  {% if cart.item_count == 0 %}

    <div class="main-cart__empty">
      <div class="main-cart__empty-icon">🛒</div>
      <h2 class="main-cart__empty-title">Your cart is empty</h2>
      <p class="main-cart__empty-text">Looks like you haven't added anything to your cart yet.</p>
      <a href="/collections/all" class="main-cart__empty-btn">Start Shopping</a>
    </div>

  {% else %}

    <form action="{{ routes.cart_url }}" method="post" class="main-cart__form">
      <div class="main-cart__grid">

        <!-- Cart Items -->
        <div class="main-cart__items">
          {% for item in cart.items %}
            <div class="main-cart__item" data-cart-item="{{ item.key }}">

              <div class="main-cart__item-image">
                {% if item.image %}
                  <a href="{{ item.url }}">
                    <img src="{{ item.image | img_url: '200x200', crop: 'center' }}" alt="{{ item.title }}">
                  </a>
                {% endif %}
              </div>

              <div class="main-cart__item-details">
                <h3 class="main-cart__item-title">
                  <a href="{{ item.url }}">{{ item.product.title }}</a>
                </h3>
                {% unless item.variant.title == 'Default Title' %}
                  <p class="main-cart__item-variant">{{ item.variant.title }}</p>
                {% endunless %}
                <p class="main-cart__item-price">{{ item.original_price | money }} each</p>
              </div>

              <div class="main-cart__item-actions">
                <span class="main-cart__item-total">{{ item.final_line_price | money }}</span>

                <div class="main-cart__quantity">
                  <button type="button" class="main-cart__quantity-btn" data-quantity-change="{{ item.key }}" data-delta="-1" aria-label="Decrease quantity">−</button>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="main-cart__quantity-value" data-quantity-input="{{ item.key }}">
                  <button type="button" class="main-cart__quantity-btn" data-quantity-change="{{ item.key }}" data-delta="1" aria-label="Increase quantity">+</button>
                </div>

                <button type="button" class="main-cart__remove" data-remove-item="{{ item.key }}">Remove</button>
              </div>

            </div>
          {% endfor %}
        </div>

        <!-- Cart Summary -->
        <div class="main-cart__summary">
          <h2 class="main-cart__summary-title">Order Summary</h2>

          {% assign free_shipping_threshold = 3500 %}
          {% assign remaining = free_shipping_threshold | minus: cart.total_price %}
          {% assign progress = cart.total_price | times: 100 | divided_by: free_shipping_threshold %}
          {% if progress > 100 %}{% assign progress = 100 %}{% endif %}

          <div class="main-cart__shipping">
            {% if remaining > 0 %}
              <p class="main-cart__shipping-text">
                Add <strong>{{ remaining | money }}</strong> more for FREE shipping!
              </p>
            {% else %}
              <p class="main-cart__shipping-text">
                <strong>🎉 You've unlocked FREE shipping!</strong>
              </p>
            {% endif %}
            <div class="main-cart__shipping-bar">
              <div class="main-cart__shipping-fill" style="width: {{ progress }}%"></div>
            </div>
          </div>

          <div class="main-cart__summary-row">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <div class="main-cart__summary-row">
            <span>Shipping</span>
            <span>{% if remaining <= 0 %}FREE{% else %}Calculated at checkout{% endif %}</span>
          </div>

          <div class="main-cart__summary-row main-cart__summary-row--total">
            <span>Total</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          {% if section.settings.show_notes %}
            <div class="main-cart__notes">
              <label class="main-cart__notes-label" for="cart-notes">Order Notes</label>
              <textarea id="cart-notes" name="note" class="main-cart__notes-input" placeholder="{{ section.settings.notes_placeholder }}">{{ cart.note }}</textarea>
            </div>
          {% endif %}

          <button type="submit" name="checkout" class="main-cart__checkout">
            Checkout • {{ cart.total_price | money }}
          </button>

          <a href="/collections/all" class="main-cart__continue">Continue Shopping</a>

          <div class="main-cart__trust">
            <span class="main-cart__trust-item">🔒 Secure checkout</span>
            <span class="main-cart__trust-item">📦 Fast shipping</span>
          </div>

        </div>

      </div>
    </form>

  {% endif %}

</div>

<script>
(function() {
  // Quantity buttons
  document.querySelectorAll('[data-quantity-change]').forEach(btn => {
    btn.addEventListener('click', function() {
      const key = this.dataset.quantityChange;
      const delta = parseInt(this.dataset.delta);
      const input = document.querySelector(`[data-quantity-input="${key}"]`);
      const newValue = Math.max(0, parseInt(input.value) + delta);
      input.value = newValue;

      // Update cart via AJAX
      updateCart(key, newValue);
    });
  });

  // Remove buttons
  document.querySelectorAll('[data-remove-item]').forEach(btn => {
    btn.addEventListener('click', function() {
      const key = this.dataset.removeItem;
      updateCart(key, 0);
    });
  });

  function updateCart(key, quantity) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: quantity })
    })
    .then(res => res.json())
    .then(() => location.reload());
  }
})();
</script>
