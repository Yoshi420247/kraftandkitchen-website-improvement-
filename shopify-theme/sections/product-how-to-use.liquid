{% comment %}
  Kraft & Kitchen - How to Use Section
  File: sections/product-how-to-use.liquid

  3-step visual instructions for using the product.
  Each step has an icon, title, and description.
{% endcomment %}

{% schema %}
{
  "name": "How to Use",
  "tag": "section",
  "class": "how-to-use-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "How to Use"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "1️⃣"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Place your design"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Position your design on the garment"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How to Use",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "1️⃣",
            "title": "Place your design",
            "description": "Position your design on the garment"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "2️⃣",
            "title": "Cover with sheet",
            "description": "Lay the PTFE cover sheet over your design"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "3️⃣",
            "title": "Press normally",
            "description": "Press at your normal settings (may need 2-3 extra seconds)"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .how-to-use {
    background: {{ section.settings.background_color }};
    padding: 40px 24px;
    border-radius: 12px;
    margin: 40px 0;
  }

  .how-to-use__heading {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.5rem;
    color: #2D2D2D;
    margin: 0 0 32px;
    text-align: center;
  }

  .how-to-use__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 32px;
    max-width: 900px;
    margin: 0 auto;
  }

  .how-to-use__step {
    text-align: center;
  }

  .how-to-use__icon {
    font-size: 2.5rem;
    margin-bottom: 12px;
  }

  .how-to-use__step-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #2D2D2D;
    margin: 0 0 8px;
  }

  .how-to-use__step-desc {
    font-size: 0.95rem;
    color: #6B6B6B;
    line-height: 1.5;
    margin: 0;
  }

  /* Connector lines between steps on desktop */
  @media (min-width: 769px) {
    .how-to-use__step {
      position: relative;
    }

    .how-to-use__step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 24px;
      right: -16px;
      width: 32px;
      height: 2px;
      background: linear-gradient(90deg, #1A7F7F 0%, #1A7F7F 50%, transparent 50%);
      background-size: 8px 2px;
    }
  }

  @media (max-width: 768px) {
    .how-to-use {
      padding: 32px 20px;
    }

    .how-to-use__steps {
      gap: 24px;
    }

    .how-to-use__icon {
      font-size: 2rem;
    }

    .how-to-use__step-title {
      font-size: 1rem;
    }
  }
</style>

{% if section.blocks.size > 0 %}
<div class="how-to-use">
  {% if section.settings.heading != blank %}
    <h2 class="how-to-use__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="how-to-use__steps">
    {% for block in section.blocks %}
      {% if block.type == 'step' %}
        <div class="how-to-use__step" {{ block.shopify_attributes }}>
          <div class="how-to-use__icon">{{ block.settings.icon }}</div>
          <h3 class="how-to-use__step-title">{{ block.settings.title }}</h3>
          <p class="how-to-use__step-desc">{{ block.settings.description }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}
