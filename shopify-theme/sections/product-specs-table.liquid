{% comment %}
  Kraft & Kitchen - Product Specifications Table
  File: sections/product-specs-table.liquid

  Displays product specifications from metafields in a clean table format.
  Uses kk namespace metafields defined in shopify-metafields.md
{% endcomment %}

{% schema %}
{
  "name": "Product Specs Table",
  "tag": "section",
  "class": "product-specs-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Specifications"
    },
    {
      "type": "checkbox",
      "id": "show_all_specs",
      "label": "Show all available specs",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "custom_spec",
      "name": "Custom Spec Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Spec Label",
          "default": "Custom Spec"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Spec Value",
          "default": "Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Specs Table"
    }
  ]
}
{% endschema %}

<style>
  .specs-table {
    margin: 40px 0;
  }

  .specs-table__heading {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.5rem;
    color: #2D2D2D;
    margin: 0 0 20px;
  }

  .specs-table__table {
    width: 100%;
    border-collapse: collapse;
  }

  .specs-table__row {
    border-bottom: 1px solid #E5E5E5;
  }

  .specs-table__row:last-child {
    border-bottom: none;
  }

  .specs-table__label,
  .specs-table__value {
    padding: 12px 0;
    font-size: 0.95rem;
    vertical-align: top;
  }

  .specs-table__label {
    color: #6B6B6B;
    width: 40%;
    font-weight: 500;
  }

  .specs-table__value {
    color: #2D2D2D;
  }

  .specs-table__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #E6F3F3;
    color: #1A7F7F;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .specs-table__badge--warning {
    background: #FEF3C7;
    color: #92400E;
  }

  @media (max-width: 768px) {
    .specs-table__label {
      width: 50%;
    }

    .specs-table__label,
    .specs-table__value {
      padding: 10px 0;
      font-size: 0.9rem;
    }
  }
</style>

{%- assign product = product -%}

<div class="specs-table">
  {% if section.settings.heading != blank %}
    <h2 class="specs-table__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <table class="specs-table__table">
    <tbody>
      {% if section.settings.show_all_specs %}

        {% comment %} Size {% endcomment %}
        {% if product.metafields.kk.size_inches %}
          <tr class="specs-table__row">
            <td class="specs-table__label">Size</td>
            <td class="specs-table__value">
              {{ product.metafields.kk.size_inches }}
              {% if product.metafields.kk.size_cm %}
                ({{ product.metafields.kk.size_cm }})
              {% endif %}
            </td>
          </tr>
        {% endif %}

        {% comment %} Material {% endcomment %}
        {% if product.metafields.kk.material %}
          <tr class="specs-table__row">
            <td class="specs-table__label">Material</td>
            <td class="specs-table__value">{{ product.metafields.kk.material }}</td>
          </tr>
        {% endif %}

        {% comment %} Thickness {% endcomment %}
        {% if product.metafields.kk.thickness_mil %}
          <tr class="specs-table__row">
            <td class="specs-table__label">Thickness</td>
            <td class="specs-table__value">
              {{ product.metafields.kk.thickness_mil }} mil
              {% if product.metafields.kk.thickness_mm %}
                ({{ product.metafields.kk.thickness_mm }} mm)
              {% endif %}
            </td>
          </tr>
        {% endif %}

        {% comment %} Coating {% endcomment %}
        {% if product.metafields.kk.coating_sides %}
          <tr class="specs-table__row">
            <td class="specs-table__label">Coating</td>
            <td class="specs-table__value">
              {% if product.metafields.kk.coating_sides == 'double' %}
                Double-sided
              {% else %}
                Single-sided
              {% endif %}
            </td>
          </tr>
        {% endif %}

        {% comment %} Max Temperature {% endcomment %}
        {% if product.metafields.kk.temp_max_f %}
          <tr class="specs-table__row">
            <td class="specs-table__label">Max Temperature</td>
            <td class="specs-table__value">
              {{ product.metafields.kk.temp_max_f }}°F
              {% if product.metafields.kk.temp_max_c %}
                ({{ product.metafields.kk.temp_max_c }}°C)
              {% endif %}
            </td>
          </tr>
        {% endif %}

        {% comment %} Color {% endcomment %}
        {% if product.metafields.kk.color %}
          <tr class="specs-table__row">
            <td class="specs-table__label">Color</td>
            <td class="specs-table__value">{{ product.metafields.kk.color }}</td>
          </tr>
        {% endif %}

        {% comment %} Pack Count {% endcomment %}
        {% if product.metafields.kk.pack_count %}
          <tr class="specs-table__row">
            <td class="specs-table__label">Pack Size</td>
            <td class="specs-table__value">{{ product.metafields.kk.pack_count }} {{ product.metafields.kk.format | default: 'pieces' }}</td>
          </tr>
        {% endif %}

        {% comment %} Reusable {% endcomment %}
        {% if product.metafields.kk.reusable != blank %}
          <tr class="specs-table__row">
            <td class="specs-table__label">Reusable</td>
            <td class="specs-table__value">
              {% if product.metafields.kk.reusable %}
                <span class="specs-table__badge">Yes - hundreds of uses</span>
              {% else %}
                Single use
              {% endif %}
            </td>
          </tr>
        {% endif %}

        {% comment %} Printer Compatible {% endcomment %}
        {% if product.metafields.kk.printer_compatible %}
          <tr class="specs-table__row">
            <td class="specs-table__label">Printer Safe</td>
            <td class="specs-table__value">
              {% case product.metafields.kk.printer_compatible %}
                {% when 'laser' %}
                  Laser only
                {% when 'inkjet' %}
                  Inkjet only
                {% when 'both' %}
                  Laser & Inkjet
                {% when 'none' %}
                  <span class="specs-table__badge specs-table__badge--warning">Not printer safe</span>
              {% endcase %}
              {% if product.metafields.kk.printer_notes %}
                <br><small>{{ product.metafields.kk.printer_notes }}</small>
              {% endif %}
            </td>
          </tr>
        {% endif %}

        {% comment %} Storage {% endcomment %}
        {% if product.metafields.kk.storage_instructions %}
          <tr class="specs-table__row">
            <td class="specs-table__label">Storage</td>
            <td class="specs-table__value">{{ product.metafields.kk.storage_instructions }}</td>
          </tr>
        {% endif %}

      {% endif %}

      {% comment %} Custom spec blocks {% endcomment %}
      {% for block in section.blocks %}
        {% if block.type == 'custom_spec' %}
          <tr class="specs-table__row" {{ block.shopify_attributes }}>
            <td class="specs-table__label">{{ block.settings.label }}</td>
            <td class="specs-table__value">{{ block.settings.value }}</td>
          </tr>
        {% endif %}
      {% endfor %}

    </tbody>
  </table>
</div>
