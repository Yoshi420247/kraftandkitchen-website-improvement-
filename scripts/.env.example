# Shopify API Credentials
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Your Shopify store name (without .myshopify.com)
SHOPIFY_STORE=kraftandkitchen

# Shopify Admin API access token
# Create in Shopify Admin > Settings > Apps > Develop apps > Create an app
# Required scopes: write_products, write_themes, write_content, write_inventory
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API version (use latest stable)
SHOPIFY_API_VERSION=2024-01

# ============================================================
# Supabase Credentials
# Find these in: Supabase Dashboard > Settings > API
# ============================================================

# Your Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service role key (for server-side operations)
# WARNING: This key bypasses Row Level Security - keep it secret
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon key (for client-side operations, optional)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
